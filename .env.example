# OpsLedger external integration placeholders.
# Copy to .env.local for local dry runs. Do not put real values in this file.

AZDO_ORG_URL=https://dev.azure.com/<organization>
AZDO_PROJECT=OpsLedger
AZDO_PIPELINE_ID=<pipeline-id>

AZDO_INCOMING_WEBHOOK_URL=<azure-devops-incoming-webhook-url>
AZDO_INCOMING_WEBHOOK_SECRET=<generated-shared-secret>
AZDO_PIPELINE_TRIGGER_PAT=<azure-devops-pipeline-trigger-pat>

NOTIFICATION_EMAIL_TO=<recipient@example.com>
NOTIFICATION_EMAIL_FROM=<sender-or-service-account@example.com>
NOTIFICATION_EMAIL_TOKEN=<provider-token-if-required>

# Future optional Teams notification path.
TEAMS_WORKFLOW_WEBHOOK_URL=<deferred-teams-workflows-webhook-url>

ADO_WORK_ITEM_DEDUPE_SALT=<generated-dedupe-salt>
ADO_WORK_ITEM_TYPE=Issue
RUN_WORK_ITEM_FAILURE_BDD=false
