<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OpsLedger.App.Pages.RequestQueuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Request Queue"
    BackgroundColor="{StaticResource PageBackground}">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label
            Style="{StaticResource PageTitleLabel}"
            Text="Request queue"
            TextColor="{StaticResource TextPrimary}" />
        <HorizontalStackLayout Spacing="12">
            <Picker
                AutomationId="StatusFilterPicker"
                ItemsSource="{Binding Statuses}"
                SelectedItem="{Binding SelectedStatus}"
                Title="Status"
                WidthRequest="180" />
            <Picker
                AutomationId="PriorityFilterPicker"
                ItemsSource="{Binding Priorities}"
                SelectedItem="{Binding SelectedPriority}"
                Title="Priority"
                WidthRequest="180" />
            <Button
                AutomationId="RefreshQueueButton"
                Command="{Binding LoadCommand}"
                Text="Refresh" />
        </HorizontalStackLayout>
        <Label
            AutomationId="QueueErrorLabel"
            Style="{StaticResource SecondaryLabel}"
            Text="{Binding ErrorMessage}"
            TextColor="#EF767A" />
        <CollectionView
            AutomationId="RequestQueueList"
            ItemsSource="{Binding Requests}">
            <CollectionView.EmptyView>
                <Label Style="{StaticResource SecondaryLabel}" Text="No service requests match the current filters." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,10"
                        Padding="14"
                        Style="{StaticResource MetricCard}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label
                                FontAttributes="Bold"
                                Text="{Binding Title}"
                                TextColor="{StaticResource TextPrimary}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding Priority}"
                                TextColor="{StaticResource Accent}" />
                            <Label
                                Grid.Row="1"
                                Style="{StaticResource SecondaryLabel}"
                                Text="{Binding Status}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryLabel}"
                                Text="{Binding Category}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
