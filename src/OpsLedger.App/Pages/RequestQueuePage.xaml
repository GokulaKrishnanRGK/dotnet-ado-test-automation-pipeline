<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OpsLedger.App.Pages.RequestQueuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Request Queue"
    BackgroundColor="{StaticResource PageBackground}">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label
            Style="{StaticResource PageTitleLabel}"
            Text="Request queue"
            TextColor="{StaticResource TextPrimary}" />
        <HorizontalStackLayout Spacing="12">
            <Picker AutomationId="StatusFilterPicker" Title="Status" WidthRequest="180" />
            <Picker AutomationId="PriorityFilterPicker" Title="Priority" WidthRequest="180" />
            <Picker AutomationId="CategoryFilterPicker" Title="Category" WidthRequest="180" />
        </HorizontalStackLayout>
        <CollectionView AutomationId="RequestQueueList">
            <CollectionView.EmptyView>
                <Label Style="{StaticResource SecondaryLabel}" Text="No service requests match the current filters." />
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
