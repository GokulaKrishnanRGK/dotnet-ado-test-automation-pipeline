<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OpsLedger.App.Pages.CreateRequestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Create Request"
    BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label
                Style="{StaticResource PageTitleLabel}"
                Text="Create service request"
                TextColor="{StaticResource TextPrimary}" />
            <Entry
                AutomationId="RequestTitleEntry"
                Placeholder="Title"
                Text="{Binding Title}" />
            <Picker
                AutomationId="RequestCategoryPicker"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding Category}"
                Title="Category" />
            <Picker
                AutomationId="RequestPriorityPicker"
                ItemsSource="{Binding Priorities}"
                SelectedItem="{Binding Priority}"
                Title="Priority" />
            <Editor
                AutomationId="RequestDescriptionEditor"
                AutoSize="TextChanges"
                Placeholder="Description"
                Text="{Binding Description}" />
            <Editor
                AutomationId="RequestImpactEditor"
                AutoSize="TextChanges"
                Placeholder="Impact details for critical requests"
                Text="{Binding ImpactDetails}" />
            <Entry
                AutomationId="RequesterNameEntry"
                Placeholder="Requester name"
                Text="{Binding RequesterName}" />
            <Entry
                AutomationId="RequesterEmailEntry"
                Keyboard="Email"
                Placeholder="Requester email"
                Text="{Binding RequesterEmail}" />
            <Button
                AutomationId="SubmitRequestButton"
                Command="{Binding SubmitCommand}"
                Text="Submit request" />
            <Label
                AutomationId="SubmitSuccessLabel"
                Style="{StaticResource SecondaryLabel}"
                Text="{Binding SuccessMessage}"
                TextColor="{StaticResource Primary}" />
            <Label
                AutomationId="SubmitErrorLabel"
                Style="{StaticResource SecondaryLabel}"
                Text="{Binding ErrorMessage}"
                TextColor="#EF767A" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
