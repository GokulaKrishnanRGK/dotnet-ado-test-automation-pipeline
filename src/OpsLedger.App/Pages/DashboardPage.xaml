<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OpsLedger.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard"
    BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label
                Style="{StaticResource PageTitleLabel}"
                Text="Operational dashboard"
                TextColor="{StaticResource TextPrimary}" />
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Style="{StaticResource MetricCard}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SecondaryLabel}" Text="New" />
                        <Label
                            AutomationId="NewRequestCountLabel"
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="{Binding NewCount}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SecondaryLabel}" Text="In Progress" />
                        <Label
                            AutomationId="InProgressRequestCountLabel"
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="{Binding InProgressCount}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SecondaryLabel}" Text="Blocked" />
                        <Label
                            AutomationId="BlockedRequestCountLabel"
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="{Binding BlockedCount}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SecondaryLabel}" Text="Resolved" />
                        <Label
                            AutomationId="ResolvedRequestCountLabel"
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="{Binding ResolvedCount}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Border Style="{StaticResource MetricCard}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Style="{StaticResource SecondaryLabel}" Text="Critical open requests" />
                    <Label
                        Grid.Column="1"
                        AutomationId="CriticalOpenRequestCountLabel"
                        FontAttributes="Bold"
                        Text="{Binding CriticalOpenCount}" />
                </Grid>
            </Border>
            <Label
                AutomationId="DashboardErrorLabel"
                Style="{StaticResource SecondaryLabel}"
                Text="{Binding ErrorMessage}"
                TextColor="#EF767A" />
            <Label FontAttributes="Bold" Text="Recent requests" />
            <CollectionView
                AutomationId="RecentRequestsList"
                ItemsSource="{Binding RecentRequests}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource SecondaryLabel}" Text="No service requests have been submitted." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,10"
                            Padding="14"
                            Style="{StaticResource MetricCard}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <Label
                                    FontAttributes="Bold"
                                    Text="{Binding Title}"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Priority}"
                                    TextColor="{StaticResource Accent}" />
                                <Label
                                    Grid.Row="1"
                                    Style="{StaticResource SecondaryLabel}"
                                    Text="{Binding Status}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryLabel}"
                                    Text="{Binding Category}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
